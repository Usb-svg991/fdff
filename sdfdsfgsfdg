<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>📚 Коллекция книг</title>
</head>
<body>
  <div class="container">
    <h1>📚 Коллекция книг</h1>
    
    <!-- Блок ошибок -->
    <div id="error-block" class="error" style="display: none;"></div>
    
    <!-- Форма добавления -->
    <form id="book-form" class="form">
      <div class="form-group">
        <label for="title-input">Название книги</label>
        <input type="text" id="title-input" placeholder="Введите название" required />
      </div>
      
      <div class="form-group">
        <label for="author-input">Автор</label>
        <input type="text" id="author-input" placeholder="Введите автора" required />
      </div>
      
      <button type="submit" id="add-btn" class="btn">➕ Добавить книгу</button>
    </form>
    
    <!-- Счётчик -->
    <p id="counter-block" class="counter">Всего книг: 0</p>
    
    <!-- Список книг -->
    <div id="cards-container" class="cards"></div>
  </div>

  <script type="module" src="./dist/main.js"></script>
</body>
</html>



