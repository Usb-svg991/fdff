class BookCollection {
  private books: Book[] = [];
  private nextId: number = 1;

  /** Добавляет книгу или возвращает null, если дубликат */
  public addBook(title: string, author: string): Book | null {
    if (this.isDuplicate(title, author)) {
      return null;
    }
    const newBook = new Book(this.nextId++, title, author);
    this.books.push(newBook);
    return newBook;
  }

   .. Возвращает копию массива ..
  public getBooks(): ReadonlyArray<Book> {
    return [...this.books];
  }

   ..Текущее количество книг..
  public getCount(): number {
    return this.books.length;
  }

        ... Проверка на дубликаты... 
  public isDuplicate(title: string, author: string): boolean {
    const normTitle = title.toLowerCase().trim();
    const normAuthor = author.toLowerCase().trim();
    return this.books.some(
      (b) => 
        b.title.toLowerCase().trim() === normTitle && 
        b.author.toLowerCase().trim() === normAuthor
    );
  }
}

